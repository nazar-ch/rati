#!/bin/sh
# why-shell: hook-dispatch — a git hook body, and the one script here that cannot move to the TS
# lane or into the kit: git runs hooks from the repo whose commits they gate, so every consumer
# must carry this file itself.
#
# So it carries as little as possible. The gate is the kit's `tools/pre-commit-gate.sh`
# (`vp staged --no-stash`, a per-worktree backup ref, the cross-worktree commit lock — kit◊WTH-03);
# this is the seam that reaches it. It is the LAST place a consumer spells the kit's path itself:
# the session hooks carried the same shape in `.claude/settings.json` until kit◊IL-07 moved them to
# a plugin that resolves the kit from its own location, needing no variable at all. A git hook
# cannot be delivered that way. A consumer adopts the gate by copying these lines once, and picks up
# every later change to it by doing nothing (kit◊WTH-02). Sourced rather than spawned, so it needs
# nothing on PATH that the gate does not need anyway.
#
# Every id here carries the `kit` alias, which is the one spelling right in all five repos these
# bytes live in: self-qualification resolves in the kit, and a consumer reads kit◊WTH-03 as the
# foreign citation it is, against the `jnana-kit` its own `citableRepos` declares (kit◊KF-01).
#
# Fails OPEN to a bare `vp staged` when the kit is not resolvable: a checkout without the kit is a
# machine without pool slots, where lint-staged's own backup is the right one and only the
# serialization is missing. Loudly, though — a gate that quietly changed shape is how kit◊FND-92
# went unnoticed for a whole effort.
#
# `$JNANA_KIT_HOME` is the whole of how the kit is found here, with no default behind it: this line
# used to guess `$HOME/Sites/jnana-kit`, which was right for one machine layout and silently wrong
# for every other. Unset now takes the same loud open arm below as a wrong path, which already
# names the variable as the fix.
KIT="${JNANA_KIT_HOME:-}"
if [ -r "${KIT}/tools/pre-commit-gate.sh" ]; then
    # The gate body is the kit's own file, outside this repo's tree by construction, so a shell
    # linter standing here has nothing to follow and says so once per run. The kit lints that file
    # directly, in the corpus it belongs to.
    # shellcheck disable=SC1091
    . "${KIT}/tools/pre-commit-gate.sh"
else
    printf 'pre-commit: no jnana-kit gate at %s — running vp staged bare: no cross-worktree commit lock, and lint-staged backs its work up onto the repo-shared refs/stash. Set JNANA_KIT_HOME.\n' "${KIT}" >&2
    exec vp staged
fi
