#!/bin/sh
# why-shell: hook-dispatch kit⭑KIT-63 — git runs a hook from the repo whose commits it gates, so every consumer carries this hop to the kit's gate itself.
#
# The gate is the kit's `tools/pre-commit-gate.ts`: two lanes, a read-only one for an agent session
# and a mutating one for a human's (kit◊RG-01). This body puts the kit's `bin/` first on PATH, which
# resolves the gate's `run-node.sh` shebang and every commit task the gate spawns, and execs the
# gate. A consumer adopts it by copying these lines once and picks up every later change by doing
# nothing (kit◊WTH-02).
#
# Every id here carries the `kit` alias, which is the one spelling right in every repo these bytes
# live in (kit◊KF-01).
#
# `$JNANA_KIT_HOME` is the whole of how the kit is found. Never add an arm for a kit, gate or node
# that is missing: the commit fails with the exec's own error (kit¶PCG-9).
PATH="${JNANA_KIT_HOME:-}/bin:${PATH}"
export PATH
exec "${JNANA_KIT_HOME:-}/tools/pre-commit-gate.ts"
