#!/bin/sh
# why-shell: hook-dispatch kit⭑KIT-63 — git runs a hook from the repo whose tree it acted on, so every consumer carries this hop to the kit's transition render itself.
#
# `.vite-hooks/post-checkout`, `.vite-hooks/post-merge` and `.vite-hooks/post-rewrite` are these
# same bytes under three names. Each finds the kit, puts the kit's `bin/` first on PATH, which
# resolves the render's `run-node.sh` shebang, and execs the kit's `tools/surface-hook.ts` under its
# own hook name: the render re-renders the gitignored read surface after a checkout, a merge or a
# rebase moved its sources (kit◊FND-210). A consumer adopts the three by copying them once, beside
# `.vite-hooks/pre-commit`, and picks up every later change by doing nothing (kit◊WTH-02).
#
# Every id here carries the `kit` alias, which is the one spelling right in every repo these bytes
# live in (kit◊KF-01).
#
# `$JNANA_KIT_HOME` is the whole of how the kit is found, exactly as in `.vite-hooks/pre-commit`,
# and a kit that carries no render takes the arm below the `if`. That arm exits `0`, because git
# makes a `post-checkout` hook's exit status the exit status of `git checkout`, and says so LOUDLY,
# because the renderings left behind describe the tree git just left.
KIT="${JNANA_KIT_HOME:-}"
if [ -x "${KIT}/tools/surface-hook.ts" ]; then
    PATH="${KIT}/bin:${PATH}"
    export PATH
    exec "${KIT}/tools/surface-hook.ts" "${0##*/}"
fi
printf '%s: no jnana-kit surface hook at %s — the read surface was NOT re-rendered, so it can describe the tree git just left. Point JNANA_KIT_HOME at a kit carrying tools/surface-hook.ts (a promotion brings the installed kit up to one), then run: kit.ts surface generate\n' "${0##*/}" "${KIT}" >&2
exit 0
