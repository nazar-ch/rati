{
    // serve.ts and vite.config.ts, on the kit's `node` profile. No `customConditions`: plain Node
    // resolves `rati/server` through the PUBLISHED entry, which the `prep` step in
    // .claude/kit.json builds. The browser half is src/tsconfig.json.
    "extends": "@jnana-app/kit/tsconfig/node.json",
    "include": ["serve.ts", "vite.config.ts"]
}
