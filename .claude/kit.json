// rati's jnana-kit manifest, JSONC; each field's contract is the kit's kit.schema.json.
//
// `$schema` names the INSTALLED copy, so the .yarnrc.yml pin picks the schema version as it picks
// the gate (kit◊ASK-04). No gate reads the pointer: it buys an editor hint.
{
    "$schema": "../node_modules/@jnana-app/kit/kit.schema.json",

    "project": "rati",

    "sizeExempt": {
        "dirFiles": [
            { "path": "packages/rati/src/__tests__/mandala", "reason": "past the limit when the size gate landed, and exempt until its split" },
            { "path": "packages/rati/src/__tests__/router", "reason": "past the limit when the size gate landed, and exempt until its split" },
        ],
    },

    "loadedByPath": [
        {
            "path": "examples/ssr/src/entry-server.tsx",
            "reason": "examples/ssr/serve.ts imports its build output, dist/server/entry-server.js, by URL for `render` and `assets`, and `vp dev` renders through it by ratiSsr()'s default entry",
        },
    ],

    "bootstrap": "yarn install",
    // `packages/rati/dist` is `prep`'s output, listed because this one trigger runs `prep` too: a
    // provisioned checkout already carries `node_modules`.
    "bootstrapStale": {
        "missing": ["node_modules", "packages/rati/dist"],
    },

    // examples/ssr/tsconfig.json resolves `rati/server`, `rati/ssr` and `rati/vite` through the
    // PUBLISHED `dist/*.d.ts` entries, so a checkout that never built fails `ssr-demo#typecheck`.
    "prep": [
        {
            "id": "rati-build",
            "label": "rati dist",
            "command": "yarn workspace rati build && echo built",
        },
    ],

    // Publishing the public `rati` package stays user-run on the host.
    "denyRules": {
        "keywords": ["release", "publish"],
        "rules": [
            {
                "id": "release",
                "category": "package publish",
                // `tokenPattern` catches every wrapping of the publish, whose command word is `npm`
                // in `yarn npm publish`, and leaves release.ts's `--publish` auth check allowed.
                "command": ["release.ts", "release"],
                "tokenPattern": "^publish$",
                "reason": "scripts/release.ts (the `release` script) and a bare `yarn npm publish` bump and publish the public `rati` package to npmjs with the token in this machine's Keychain, and re-running does not undo a publish. Releasing is the maintainer's call (docs/current/RELEASING.md); `--dry-run` is the only safe form and is still user-run."
            },
        ],
    },

    // rati's findings track their downstream in jnana, and its configs cite the kit records their
    // shape comes from.
    "citableRepos": ["jnana", "jnana-kit"],

    // Walks DOWN only: a raise is the user's call, never a branch's. The root CLAUDE.md stays an
    // empty tracked file, so a session reads one surface.
    "memory": {
        "alwaysLoadedTotal": 9320,
    },

    "styleSweep": {
        "docsBaseline": "fe110d8b843ef1936918920c399c1a189cd56928",
        "commentsBaseline": "037cecb68a44c459bb0bb01356f8957d979b746d",
    },

    "testOnlyExports": {
        "state": "count",
        "ceiling": 12,
        "reason": "rati's own test-only and unimported exports, counted when kit◊TT-60 took the check to its default; a sweep giving each its own file or un-exporting it lowers the ceiling and deletes the key",
    },

    "terms": {
        "state": "count",
        "ceiling": { "spec-ids/span": 336 },
        "reason": "rati defines no product tier, so every emphasis span reads as an unresolved term; its prose answers to the doc-style sweep that converts stress emphasis to caps, and that sweep lowers this ceiling to zero and deletes the key",
    },
    "spawnFence": { "state": "off", "reason": "the spawn fence was not meant for a *consumer*; kit◊DES-18 decides the conversion and ends this key" },
}
