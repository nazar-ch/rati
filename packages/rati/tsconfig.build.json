{
    // The build compiles exactly the program src/tsconfig.json describes, so it extends that file
    // rather than a kit profile.
    "extends": "./src/tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        // tsc accepts the inherited `allowImportingTsExtensions` beside an emit only when it writes
        // no JavaScript.
        "emitDeclarationOnly": true,
        "outDir": "./dist",
        // Anchors the declaration emit, so `dist/` mirrors `src/` and every `exports` target in
        // package.json keeps its path.
        "rootDir": "./src",
        // The one config in the repo that emits: every kit profile is no-emit.
        "noEmit": false
    }
}
